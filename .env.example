# ================================================================
# Taqyeemi Environment Variables Template (Cloudflare Pages + D1)
# Copy to .env for local development. Never commit real secrets to Git.
# ================================================================

# Cloudflare D1
# Database Name: taqyeemi-db
# Database ID: 5d85a60d-80dd-4709-8ad1-334d215ef120

# Admin & Session Secrets
ADMIN_SECRET=dev-admin-secret-replace-in-production
SESSION_SECRET=dev-session-secret-min-32-chars-replace-in-production

# Resend API Configuration (Server-side notification & OTP emails)
RESEND_API_KEY=
EMAIL_FROM=Taqyeemi Login <auth@taqyeemi.com>

# Application Routing URLs
PUBLIC_FUNNEL_URL=https://taqyeemi.pages.dev

# Administrative Notification Destination
ADMIN_EMAIL=admin@yourdomain.com
