# ================================================================
# Taqyeemi Environment Variables Template
# Copy to .env for local development. Never commit real secrets to Git.
# ================================================================

# Supabase Public Configuration (Safe for browser / Client runtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Secret (REQUIRED for Cloudflare Pages /api/activate and admin operations)
# NEVER expose to browser or commit to Git
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API Configuration (Server-side notification emails)
# NEVER expose to browser or commit to Git
RESEND_API_KEY=

# Application Routing URLs
PUBLIC_FUNNEL_URL=https://taqyeemi.pages.dev
OWNER_APP_URL=https://app-taqyeemi.pages.dev
DASHBOARD_URL=https://app-taqyeemi.pages.dev
ADMIN_APP_URL=https://admin-taqyeemi.pages.dev

# Administrative Notification Destination
ADMIN_EMAIL=admin@yourdomain.com

# Local Server Ports
PORT_LANDING=3000
PORT_DASHBOARD=3001
PORT_ADMIN=3002
